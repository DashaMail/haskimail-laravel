{
    "name": "dashamail/haskimail-laravel",
    "description": "Official-grade Haskimail mail transport, API client and webhooks for Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "mail",
        "transport",
        "haskimail",
        "transactional",
        "email",
        "webhooks"
    ],
    "homepage": "https://haskimail.ru/developer",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/bus": "^11.44 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.44 || ^12.0 || ^13.0",
        "illuminate/http": "^11.44 || ^12.0 || ^13.0",
        "illuminate/mail": "^11.44 || ^12.0 || ^13.0",
        "illuminate/queue": "^11.44 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.44 || ^12.0 || ^13.0",
        "illuminate/support": "^11.44 || ^12.0 || ^13.0",
        "nesbot/carbon": "^2.72.6 || ^3.8",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/mailer": "^7.0 || ^8.0",
        "symfony/mime": "^7.0 || ^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Haskimail\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Haskimail\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Haskimail\\Laravel\\HaskimailServiceProvider"
            ],
            "aliases": {
                "Haskimail": "Haskimail\\Laravel\\Facades\\Haskimail"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "check": [
            "@format --test",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
